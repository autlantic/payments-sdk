# Billing mode
# Leave API_KEY empty to use in-process sandbox (recommended for first run).

# Merchant portal UI (links only)
NEXT_PUBLIC_BILLING_PORTAL_URL=https://portal.autlantic.com

# Hosted billing REST API (NOT the portal UI host)
AUTLANTIC_BILLING_API_URL=https://billing.autlantic.com
# Local API: AUTLANTIC_BILLING_API_URL=http://localhost:8788

# AUTLANTIC_BILLING_API_KEY=abk_test_...
AUTLANTIC_BILLING_MERCHANT_ID=mer_demo_store
AUTLANTIC_BILLING_SANDBOX=true
AUTLANTIC_BILLING_WEBHOOK_SECRET=whsec_demo_store

# Merchant settlement wallet on Base (required for createSubscription)
AUTLANTIC_PAYOUT_ADDRESS_EVM=0x1111111111111111111111111111111111111111
